# Copy this file to .env (git-ignored) and fill in your key.

# --- Qwen Cloud (OpenAI-compatible) ---
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
OPENAI_MODEL=qwen3.8-flash
OPENAI_API_KEY=paste-your-key-here
# Short e-mails do not need reasoning; JSON output mode needs thinking off.
OPENAI_EXTRA_BODY={"enable_thinking": false}

# --- or a local model through Ollama (default when LLM_PROVIDER is not set) ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
