{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.API/bin/Debug/net8.0/MusicEventManagementSystem.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.API",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5255"
            }
        },
        {
            "name": "Client (Vite)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.Client",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:\\s+(https?://\\S+)"
            }
        },
        {
            "name": "ML service (FastAPI)",
            "type": "node-terminal",
            "request": "launch",
            "command": "${workspaceFolder}/ml-service/.venv/Scripts/python -m uvicorn app.main:app --port 8000",
            "cwd": "${workspaceFolder}/ml-service"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "MEMS: API + Client + ML service",
            "configurations": [
                "API (.NET)",
                "Client (Vite)",
                "ML service (FastAPI)"
            ],
            "stopAll": true
        },
        {
            "name": "MEMS: API + Client",
            "configurations": [
                "API (.NET)",
                "Client (Vite)"
            ],
            "stopAll": true
        }
    ]
}