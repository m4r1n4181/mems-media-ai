{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.API",
                "--launch-profile",
                "http"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "client: npm install",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.Client"
            },
            "problemMatcher": []
        },
        {
            "label": "client: dev",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.Client"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "client: build",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/MusicEventManagementSystem/MusicEventManagementSystem.Client"
            },
            "problemMatcher": [
                "$tsc"
            ]
        }
    ]
}
